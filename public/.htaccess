ErrorDocument 404 /404.html

# Nunca servir metadatos de git ni dotfiles del deploy
RedirectMatch 404 /\.git
RedirectMatch 404 /\.gitignore$

# Cache: solo /_astro/ lleva hash en el nombre (inmutable); HTML revalida siempre
<IfModule mod_setenvif.c>
  SetEnvIf Request_URI "^/_astro/" ASTRO_HASHED
</IfModule>
<IfModule mod_headers.c>
  Header set Cache-Control "public, max-age=31536000, immutable" env=ASTRO_HASHED
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

