---
import { waLink } from '@/lib/site';
interface Props {
  message: string;
  label: string;
  variant?: 'primary' | 'outline';
}
const { message, label, variant = 'primary' } = Astro.props;
const styles =
  variant === 'primary'
    ? 'bg-fire text-parchment-light hover:bg-amber hover:text-ink'
    : 'border-2 border-fire text-fire hover:bg-fire hover:text-parchment-light';
---
<a
  href={waLink(message)}
  target="_blank"
  rel="noopener"
  class={`inline-block rounded-lg px-6 py-3 font-display font-bold tracking-wide no-underline transition-[color,background-color,border-color,box-shadow,transform] duration-200 ease-out hover:shadow-md active:translate-y-px active:shadow-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber focus-visible:ring-offset-2 ${styles}`}
>
  {label}
</a>
