---
interface Props { eyebrow?: string; title: string }
const { eyebrow, title } = Astro.props;
---
<div class="mx-auto mb-10 max-w-2xl text-center">
  {eyebrow && <p class="mb-1 text-sm font-bold uppercase tracking-widest text-fire">{eyebrow}</p>}
  <h2 class="font-display text-3xl font-bold text-wood sm:text-4xl">{title}</h2>
</div>
