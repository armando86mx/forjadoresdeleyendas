---
import { Image } from 'astro:assets';
import escudo from '@/assets/img/escudo.png';
const nav = [
  { href: '/', label: 'Inicio' },
  { href: '/#banquete', label: 'El Banquete' },
  { href: '/#precios', label: 'Precios' },
  { href: '/faq', label: 'FAQ' },
  { href: '/cronicas', label: 'Crónicas' },
];
const { pathname } = Astro.url;
const isActive = (href: string) =>
  href === '/' ? pathname === '/' : !href.includes('#') && pathname.startsWith(href);
---
<header class="sticky top-0 z-50 bg-ink/95 text-parchment-light backdrop-blur">
  <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-y-1 px-4 py-2">
    <a href="/" class="flex min-h-11 items-center gap-3 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber rounded">
      <Image src={escudo} alt="" aria-hidden="true" width={48} densities={[1, 2, 3]} loading="eager" />
      <span class="font-display text-base font-bold tracking-wide whitespace-nowrap sm:text-lg">Forjadores de Leyendas</span>
    </a>
    <nav aria-label="Principal" class="max-sm:w-full">
      <ul class="flex flex-wrap justify-center gap-x-1 text-sm sm:gap-x-2">
        {nav.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class:list={[
                'inline-flex min-h-11 items-center rounded px-3 transition-colors hover:text-amber focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber',
                isActive(item.href) && 'font-bold text-amber underline decoration-2 underline-offset-8',
              ]}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>
