---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
const posts = (await getCollection('cronicas')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const labels = { cronicas: 'Crónica', aliados: 'Aliados' };
---
<BaseLayout
  title="Crónicas de la Posada — Blog de rol y D&D en Puebla"
  description="Historias, sesiones y aventuras registradas por el posadero: crónicas de la comunidad rolera y de nuestros aliados en todo el país."
>
  <div class="mx-auto max-w-3xl px-4 py-16">
    <h1 class="font-display text-4xl font-bold text-wood">Crónicas de la Posada</h1>
    <p class="mt-2 opacity-80">Aquí el posadero registra las gestas que nacen en estas mesas.</p>
    <p class="mt-2 max-w-prose text-sm opacity-80">Crónicas y guías sobre rol y Dungeons &amp; Dragons en Puebla, escritas desde la barra de la posada.</p>
    <div class="mt-10 space-y-6">
      {posts.map((post) => (
        <a href={`/cronicas/${post.id}/`} class="card card-lift block rounded-lg bg-parchment-light p-6">
          <p class="text-xs font-bold uppercase tracking-widest text-wood">{labels[post.data.categoria]}</p>
          <h2 class="mt-1 font-display text-2xl text-wood">{post.data.title}</h2>
          <p class="mt-2 max-w-prose text-sm opacity-80">{post.data.description}</p>
          <time class="mt-2 block text-xs opacity-75" datetime={post.data.pubDate.toISOString()}>
            {post.data.pubDate.toLocaleDateString('es-MX', { dateStyle: 'long' })}
          </time>
        </a>
      ))}
    </div>
    <div class="mt-12 text-center not-prose">
      <a
        href="/#eventos"
        class="inline-block rounded-lg bg-fire px-6 py-3 font-display font-bold tracking-wide text-parchment-light no-underline transition-[color,background-color,border-color,box-shadow,transform] duration-200 ease-out hover:bg-amber hover:text-ink hover:shadow-md active:translate-y-px active:shadow-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber focus-visible:ring-offset-2"
      >
        Únete a una partida
      </a>
    </div>
  </div>
</BaseLayout>
